# Configure hosted secrets in Cloudflare Workers. Never commit their values.
# For local Wrangler development, use an ignored .dev.vars file.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
MISTRAL_API_KEY=
# Cloudflare Workers AI uses the AI binding, without a separate API key.
# At least 32 random characters; required for saving encrypted API keys in UI.
AI_KEY_ENCRYPTION_SECRET=
# Matches API_KEY in the TikTok LIVE Konektor server (server-side only).
TLK_API_KEY=
# hmacSecret from koneklive's Webhook integration (not its REST API key).
KONEKLIVE_WEBHOOK_SECRET=
# Optional Graph API version for Instagram profile sources (not a secret).
# Per-source Instagram/TikTok/connector tokens are entered in Sources and encrypted.
# INSTAGRAM_GRAPH_VERSION=v25.0
